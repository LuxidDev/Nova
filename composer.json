{
  "name": "luxid/nova",
  "description": "Reactive templating engine for Luxid PHP Framework",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "php",
    "luxid",
    "templating",
    "components",
    "ssr"
  ],
  "authors": [
    {
      "name": "Jhay",
      "email": "jhay@luxid.dev"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Luxid\\Nova\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Luxid\\Nova\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests",
    "analyse": "phpstan analyse src --level=5",
    "example": "php examples/simple-counter.php"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "version": "0.2.0",
  "config": {
    "sort-packages": true
  }
}
